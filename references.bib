@article{alvarez_shape_2005,
	series = {36th {International} {Conference} on {Coordination} {Chemistry}, {Merida}, {Mexico}, {July} 2004},
	title = {Shape maps and polyhedral interconversion paths in transition metal chemistry},
	volume = {249},
	issn = {0010-8545},
	url = {https://www.sciencedirect.com/science/article/pii/S0010854505001116},
	doi = {10.1016/j.ccr.2005.03.031},
	abstract = {A systematic study of the stereochemistry of the coordination sphere of transition metal compounds has been carried out recently from the point of view of the continuous shape measures (CShM). In this review, the concept of the continuous shape measures is summarized and the derived tools, the shape maps and the path deviation functions are described. The main stereochemical trends that have been deduced from the application of such tools to more than 23,000 crystallographically independent fragments of coordination numbers between four and eight are also summarized.},
	number = {17},
	urldate = {2026-10-13},
	journal = {Coordination Chemistry Reviews},
	author = {Alvarez, Santiago and Alemany, Pere and Casanova, David and Cirera, Jordi and Llunell, Miquel and Avnir, David},
	month = sep,
	year = {2005},
	keywords = {Continuous shape measures, Coordination polyhedra, Stereochemistry},
	pages = {1693--1708},
}

